#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$SCRIPT_DIR/atlas-agent.exe" ]; then
  exec "$SCRIPT_DIR/atlas-agent.exe" "$@"
elif [ -f "$SCRIPT_DIR/atlas-agent" ] && [ -x "$SCRIPT_DIR/atlas-agent" ]; then
  exec "$SCRIPT_DIR/atlas-agent" "$@"
else
  echo "atlas-agent binary not found. Run: node scripts/postinstall.mjs" >&2
  exit 1
fi
